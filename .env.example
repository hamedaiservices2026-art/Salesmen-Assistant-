# Local development: leave DATABASE_URL unset to use the in-process PGlite database in .data/
# Deployment: use the DIRECT Postgres connection string (port 5432), see docs/DEPLOY.md
# DATABASE_URL=postgres://user:password@host:5432/postgres

# Demo data only (see README and docs/DEPLOY.md):
# APP_TODAY=2026-11-14
# ALLOW_APP_TODAY=1

# AI layer (plan 3). Keys are optional; without them AI is unavailable and typing still works.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# AI_DISABLED=1            # kill switch: no provider is ever called
# AI_PROVIDER=fake         # tests and demos only; needs ALLOW_AI_FAKE=1 when NODE_ENV=production
# ALLOW_AI_FAKE=1
# AI_GEMINI_VISION_MODEL= AI_GEMINI_CHAT_MODEL= AI_GEMINI_AUDIO_MODEL= AI_GROQ_STT_MODEL=
# AI_OPENROUTER_VISION_MODEL= AI_OPENROUTER_CHAT_MODEL=
# AI_GLOBAL_DAY_VISION=400 AI_GLOBAL_DAY_STT=600 AI_GLOBAL_DAY_CHAT=800
# AI_GLOBAL_MINUTE_VISION= AI_GLOBAL_MINUTE_STT= AI_GLOBAL_MINUTE_CHAT=
# Private photos (Task 6): SUPABASE_URL=https://<ref>.supabase.co  SUPABASE_SERVICE_ROLE_KEY=
