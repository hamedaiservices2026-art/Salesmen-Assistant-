# Local development: leave DATABASE_URL unset to use the in-process PGlite database in .data/
# Deployment: use the DIRECT Postgres connection string (port 5432), see docs/DEPLOY.md
# DATABASE_URL=postgres://user:password@host:5432/postgres

# Demo data only (see README and docs/DEPLOY.md):
# APP_TODAY=2026-11-14
# ALLOW_APP_TODAY=1

# AI layer (plan 3). Keys are optional; without them AI is unavailable and typing still works.
# Keys are read on the server only. In a deployment set them as Production variables; never name one NEXT_PUBLIC_*.
# GEMINI_API_KEY=              # Google AI Studio: report photos and assistant questions (and the voice fallback)
# GROQ_API_KEY=                # Groq: voice recordings to text
# OPENROUTER_API_KEY=          # optional second provider; used only where its model id below is also set
# AI_DISABLED=1                # kill switch: no provider is ever called, whatever a company's setting says
# AI_PROVIDER=fake             # offline fake provider for tests and local demos ONLY; ignored by a production build unless ALLOW_AI_FAKE=1
# ALLOW_AI_FAKE=1              # end-to-end runs only; never set on a deployment
# Model ids are configuration. The defaults were verified live on 2026-11-26 (docs/ai-providers.md); AI_SMOKE=1 pnpm ai:smoke re-checks them with your keys.
# AI_GEMINI_VISION_MODEL=      # photos; default gemini-4-hydrogen
# AI_GEMINI_CHAT_MODEL=        # assistant questions; default gemini-4-hydrogen
# AI_GEMINI_AUDIO_MODEL=       # voice fallback when Groq is unavailable; default gemini-4-hydrogen
# AI_GEMINI_FALLBACK_MODEL=    # used once when the primary Gemini model answers 503/429; default gemini-3.5-flash-lite; none = off
# AI_GROQ_STT_MODEL=           # voice; default whisper-large-v3
# AI_OPENROUTER_VISION_MODEL=  # default google/gemma-4-31b-it:free (free tier: ~20/min, 50/day; may log prompts)
# AI_OPENROUTER_CHAT_MODEL=    # default google/gemma-4-31b-it:free
# AI_GEMINI_THINKING=low       # low (default) | off (= minimal level; a budget of 0 is rejected by Gemini 3/4) | default (send nothing) | a whole token budget
# AI_CONTEXT_MAX=60000         # characters of context per assistant question, 5000 to 60000
# Daily requests for the whole deployment, per kind (photos, voice, questions):
# AI_GLOBAL_DAY_VISION=400
# AI_GLOBAL_DAY_STT=600
# AI_GLOBAL_DAY_CHAT=800
# Requests per minute for the whole deployment (none until set; about 80 percent of the provider's own limit):
# AI_GLOBAL_MINUTE_VISION=
# AI_GLOBAL_MINUTE_STT=
# AI_GLOBAL_MINUTE_CHAT=
# Private photos. Local disk by default (development, tests). A production build refuses the local disk
# (a serverless disk does not persist), so a deployment uses Supabase Storage.
# STORAGE_DRIVER=local         # local | supabase
# FILES_DIR=.data/files        # local driver only
# ALLOW_LOCAL_FILES=1          # local driver in a production build: a single server with a lasting disk, or the end-to-end runs. Not for Vercel.
# STORAGE_DRIVER=supabase
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # sb_secret_... (or a legacy service_role JWT); server only, never NEXT_PUBLIC_
# STORAGE_BUCKET=private-files # create it PRIVATE in Supabase; the app never creates buckets or public URLs
